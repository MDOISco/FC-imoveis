# Banco de dados local (SQLite) — sem segredos neste arquivo.
# A chave da API de IA é configurada dentro do sistema, em Configurações.
DATABASE_URL="file:./dev.db"

# URL base usada para montar links absolutos (fotos nos feeds dos portais).
# Em produção, troque pelo domínio público do sistema.
APP_URL="http://localhost:3000"

# Senha única da equipe para acessar o dashboard (deixe comentado no
# desenvolvimento local para não pedir senha). Em produção, DEFINA!
# DASHBOARD_SENHA="troque-esta-senha"
